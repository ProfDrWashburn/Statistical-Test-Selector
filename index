/* comparison options depend on outcome type */
function compareOptions(otype){
  const base=[
    {v:'prepost',t:'One group, measured before and after',d:'The same patients or units measured at two points. The most common practice-project design.'},
    {v:'twogroup',t:'Two separate groups',d:'For example, an intervention unit compared with a comparison unit.'},
    {v:'multi',t:'Three or more time points or groups',d:'Several measurement points over time, or three or more groups compared at once.'},
    {v:'benchmark',t:'Compared against a fixed target or benchmark',d:'For example, comparing your result to a published standard or organizational goal.'},
    {v:'describe',t:'Just describe the result, no formal comparison',d:'Summarize what happened. Often the right and sufficient choice.'}
  ];
  if(otype==='rate'){
    return [
      {v:'timeseries',t:'Track the measure over many time points',d:'Plot the rate or count over time. The standard QI approach.'},
      {v:'prepost',t:'Collapse to a single before and after comparison',d:'Possible, but a time-series chart usually tells you more.'},
      {v:'describe',t:'Just describe the rates',d:'Report the percentages or counts plainly.'}
    ];
