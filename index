    </div>`;
  document.getElementById('steps').innerHTML=html;

  document.querySelectorAll('#steps .opt').forEach(btn=>{
    btn.addEventListener('click',()=>{
      state[step.key]=btn.dataset.v;
      advance(id,btn.dataset.v);
    });
  });
}

function advance(fromId,val){
  history.push(fromId);
  if(fromId==='gate'){
    if(val==='research'){ renderStep('gate-research'); return; }
    renderStep('otype'); return;
  }
  if(fromId==='otype'){ renderStep('compare'); return; }
  if(fromId==='compare'){
    if(val==='twogroup'){ renderStep('rand'); return; }
    // distribution question only for continuous mean-based comparisons
    const needsDist = state.otype==='cont' && ['prepost','multi'].includes(val);
    if(needsDist){ renderStep('dist'); return; }
    renderResult(); return;
  }
  if(fromId==='rand'){
    if(state.otype==='cont'){ renderStep('dist'); return; }
    renderResult(); return;
  }
  if(fromId==='dist'){ renderResult(); return; }
}

function renderResult(){
  renderCrumbs();
  document.getElementById('back').style.display='inline-block';
  const r=recommend(state);
  if(!r){ document.getElementById('steps').innerHTML='<div class="card">Something did not map. Please start over.</div>'; return; }
  const d=designFor(state);

  document.getElementById('steps').innerHTML=`
    <div class="card" style="border-left:5px solid var(--clay)">
      <span class="step-label" style="color:var(--clay)">Recommended design</span>
      <h2 style="font-size:22px;margin-bottom:6px">${autoGloss(d.name)}</h2>
      <p class="lead" style="margin-bottom:0">${autoGloss(d.def)}</p>
      ${d.flag?`<div class="warnbox" style="margin-top:14px"><b>Heads up.</b> ${autoGloss('A randomized controlled trial usually counts as research rather than practice improvement. If your intent is local improvement, a quasi-experimental nonequivalent comparison group design gives you a comparison while keeping the project feasible and typically non-research.')}</div>`:''}
    </div>
    <div class="result-head">
      <div class="rk">Recommended analysis</div>
      <h2>${r.name}</h2>
      <div class="rsub">${r.sub}</div>
    </div>
    <div class="card">
      <div class="rgrid">
        <div class="rbox">
          <h4>Use this</h4>
          <p><span class="big">${autoGloss(r.primary)}</span></p>
          <div style="margin-top:8px">${r.tags.map(t=>`<span class="pill">${t}</span>`).join('')}</div>
        </div>
        <div class="rbox">
          <h4>Alternative</h4>
          <p>${autoGloss(r.alt)}</p>
        </div>
      </div>
      <div class="rbox" style="margin-top:16px">
        <h4>What to report</h4>
        <ul class="reportlist">${r.report.map(x=>`<li>${autoGloss(x)}</li>`).join('')}</ul>
      </div>
      <div class="warnbox"><b>Keep it simple, and keep it honest.</b> ${autoGloss(r.note)}</div>
    </div>
    <div class="card">
      <span class="step-label">Draft methods summary</span>
      <h2 style="font-size:21px;margin-bottom:6px">Design and analysis summary</h2>
      <p class="lead">Edit the bracketed placeholders to fit your project, then copy this into your methods section. It is written in proposal tense and is a starting draft, not a finished methods section.</p>
      <textarea id="summaryText" class="summary" spellcheck="false">${summaryFor(state)}</textarea>
      <div class="btn-row" style="margin-top:12px"><button class="btn" id="copyBtn">Copy text</button></div>
    </div>`;

  const ta=document.getElementById('summaryText');
  if(ta){
    ta.style.height='auto';
    ta.style.height=(ta.scrollHeight+6)+'px';
    document.getElementById('copyBtn').addEventListener('click',()=>{
      ta.select();
      try{ document.execCommand('copy'); }catch(e){}
      if(navigator.clipboard){ navigator.clipboard.writeText(ta.value).catch(()=>{}); }
      const b=document.getElementById('copyBtn');
      b.textContent='Copied'; setTimeout(()=>{b.textContent='Copy text';},1500);
    });
  }
}

/* ---------- nav buttons ---------- */
function restart(){
  for(const k in state) delete state[k];
  history.length=0;
  renderStep('gate');
}
document.getElementById('restart').addEventListener('click',restart);
document.getElementById('back').addEventListener('click',()=>{
  const prev=history.pop();
  if(prev===undefined){ restart(); return; }
  // clear forward state
  const order=['gate','otype','compare','rand','dist'];
  const idx=order.indexOf(prev);
  order.slice(idx).forEach(k=>{ delete state[STEPS[k]?STEPS[k].key:k]; });
  if(prev==='gate-research'){ renderStep('gate'); return; }
  renderStep(prev);
});

/* init */
renderStep('gate');
</script>
</body>
</html>
