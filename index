/* ---------- tab switching ---------- */
document.querySelectorAll('nav.tabs button').forEach(b=>{
  b.addEventListener('click',()=>{
    document.querySelectorAll('nav.tabs button').forEach(x=>x.classList.remove('active'));
    document.querySelectorAll('.panel').forEach(x=>x.classList.remove('active'));
    b.classList.add('active');
    document.getElementById(b.dataset.tab).classList.add('active');
    window.scrollTo({top:0,behavior:'smooth'});
  });
});

/* ---------- inline definitions ---------- */
const TERMS={
  'continuous':'A measurement on a numeric scale where the spacing between values is equal and meaningful, such as weight, blood pressure, or a summed score.',
  'categorical':'A variable that sorts each case into a named group with no built-in order, such as yes or no.',
  'ordinal':'A variable with a clear order but unequal or unknown spacing between values, such as a 1 to 5 rating.',
  'dependent variable':'The outcome you measure and expect your intervention to affect.',
  'parametric':'A test that assumes the outcome is continuous and roughly normally distributed, and compares means. The t test is the common example.',
  'nonparametric':'A test that makes fewer assumptions and compares ranks or medians instead of means. The safer choice with small or skewed samples.',
  'skewed':'A lopsided distribution, with a tail pulled toward the high or low end rather than being symmetric.',
  'median':'The middle value when the data are ordered. Used instead of the mean for skewed or ordinal data.',
  'standard deviation':'A measure of how spread out the values are around the mean.',
  'interquartile range':'The middle 50 percent of the values. A spread measure usually reported with the median.',
  'confidence interval':'A plausible range for the true effect. A narrower range means a more precise estimate.',
  'effect size':'A number describing how large a difference is in practical terms, separate from whether it reached statistical significance.',
  'Cohen d':'A common effect size for comparing two means, expressed in standard deviation units.',
  'phi':'An effect size for a 2 by 2 categorical comparison (two groups, a yes or no outcome).',
  'Cramer V':'An effect size for categorical comparisons that have more than two categories.',
  'p value':'How surprising your result would be if nothing had truly changed. A small value suggests the difference is unlikely to be chance alone.',
  'randomization':'Assigning participants to groups by chance, which balances out unknown differences. It is the defining feature of a true experiment.',
  'pre-experimental':'A simple design with one group and no comparison group, such as measuring before and after. Easy to run, but weaker for showing that the intervention caused the change.',
  'quasi-experimental':'A design with a comparison built in (a separate group, or repeated measures over time) but without random assignment.',
  'experimental':'A design using random assignment and a control group. The strongest design for showing cause, and usually classified as research.',
  'interrupted time series':'Measuring the outcome many times before and after a change to see whether the pattern shifts. Displayed with run or control charts.',
  'run chart':'A graph of your measure plotted in time order against a median line, used to spot real shifts, trends, and runs.',
  'control chart':'A run chart with statistically calculated limits, used to tell ordinary variation apart from a real signal. Also called an SPC or Shewhart chart.',
  'common cause':'The normal, expected variation present in any stable process.',
  'special cause':'Variation that signals something real has changed, beyond normal fluctuation.',
  'paired-samples t test':'Compares the mean before and after within one group.',
  'independent-samples t test':'Compares the means of two separate groups.',
  'one-sample t test':'Compares one group mean against a single fixed target value.',
  'one-way ANOVA':'Compares the means of three or more separate groups at once.',
  'repeated-measures ANOVA':'Compares the means of one group across three or more time points.',
  'Wilcoxon signed-rank test':'The rank-based alternative to the paired t test, for one group measured before and after.',
  'Mann-Whitney U test':'The rank-based alternative to the independent t test, for two separate groups.',
  'Kruskal-Wallis test':'The rank-based alternative to one-way ANOVA, for three or more groups.',
  'Friedman test':'The rank-based alternative to repeated-measures ANOVA, for three or more time points in one group.',
  'McNemar test':'Compares a yes or no outcome before and after in the same people.',
  'chi-square test':'Tests whether a yes or no outcome differs between separate groups.',
  'Fisher exact test':'Used in place of chi-square when group sizes or expected counts are very small.',
  'binomial test':'Compares one observed proportion against a fixed target proportion.'
};
const GLOSS_ORDER=Object.keys(TERMS).sort((a,b)=>b.length-a.length);
function escapeRe(s){return s.replace(/[.*+?^${}()|[\]\\]/g,'\\$&');}
function autoGloss(text){
  if(!text) return text;
  const tokens=[];
  let out=text;
  GLOSS_ORDER.forEach(phrase=>{
    const re=new RegExp('\\b'+escapeRe(phrase)+'\\b','i');
    out=out.replace(re,(m)=>{
      const i=tokens.length;
      tokens.push('<span class="term" data-def="'+TERMS[phrase].replace(/"/g,'&quot;')+'">'+m+'</span>');
      return '\u0001'+i+'\u0001';
    });
  });
  return out.replace(/\u0001(\d+)\u0001/g,(m,i)=>tokens[+i]);
}
/* tooltip element and handlers */
const TIP=document.createElement('div');TIP.className='tip';TIP.style.display='none';document.body.appendChild(TIP);
function showTip(el){
  TIP.textContent=el.getAttribute('data-def');
  TIP.style.display='block';
  const r=el.getBoundingClientRect();
  const tw=TIP.offsetWidth, th=TIP.offsetHeight;
  let left=Math.min(window.innerWidth-tw-10, Math.max(10, r.left));
  let top=r.bottom+8;
  if(top+th>window.innerHeight-10) top=r.top-th-8;
  TIP.style.left=left+'px';TIP.style.top=top+'px';
}
function hideTip(){TIP.style.display='none';}
document.addEventListener('mouseover',e=>{const t=e.target.closest('.term');if(t)showTip(t);});
document.addEventListener('mouseout',e=>{if(e.target.closest('.term'))hideTip();});
document.addEventListener('click',e=>{
  const t=e.target.closest('.term');
  if(t){e.stopPropagation();if(TIP.style.display==='block'&&TIP.textContent===t.getAttribute('data-def')){hideTip();}else{showTip(t);}}
  else{hideTip();}
});
window.addEventListener('scroll',hideTip,true);

