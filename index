}

/* ---------- recommendation engine ---------- */
function recommend(s){
  const o=s.otype, c=s.compare, d=s.dist;

  // process / time-series outcome
  if(o==='rate' && c==='timeseries'){
    return {
      name:'Run chart, then a control chart as data grow',
      sub:'Time-series display, the standard analytic approach for QI',
      primary:'Run chart (median centerline)',
      alt:'Move to a control chart (p-chart for a percentage, c-chart or u-chart for counts and rates) once you have roughly 15 to 20 points',
      report:['Each data point plotted in time order','A median centerline (run chart) or mean with control limits (control chart)','Annotations marking when each change was made','Run-chart rules: a shift of 6 or more points on one side, a trend of 5 or more, or an unusually extreme point'],
      tags:['No p value needed','Shows whether the change held','Separates real signal from noise'],
      note:'This is usually the strongest and simplest analysis for a QI project. It directly shows whether your change produced a sustained improvement.'
    };
  }

  // describe only
  if(c==='describe'){
    const map={
      cont:'Means and standard deviations, with the range',
      cat:'Frequencies and percentages',
      ord:'Medians and interquartile range, plus frequencies',
      rate:'Rates or percentages, shown over time where possible'
    };
    return {
      name:'Descriptive statistics only',
      sub:'No inferential test required',
      primary:map[o],
      alt:'Add a simple chart (bar chart, line over time) to make the pattern visible',
      report:['A clear table of the summary numbers','Pre and post side by side where relevant','A short plain-language statement of the practical change'],
      tags:['Simplest option','Fully defensible for many projects'],
      note:'About one in five DNP projects use descriptive statistics alone. If your aim is to document a local change rather than test a hypothesis, this is appropriate and you do not need a p value.'
    };
  }

  // continuous
  if(o==='cont'){
    if(c==='prepost') return wrap('Paired-samples t test','Wilcoxon signed-rank test',d,'cont','paired');
    if(c==='twogroup') return wrap('Independent-samples t test','Mann-Whitney U test',d,'cont','indep');
    if(c==='multi')   return wrap('One-way ANOVA (groups) or repeated-measures ANOVA (time points)','Kruskal-Wallis test (groups) or Friedman test (time points)',d,'cont','multi');
    if(c==='benchmark') return {
      name:'One-sample t test',sub:'Continuous outcome compared to a fixed value',
      primary:'One-sample t test',alt:'If skewed or small: one-sample Wilcoxon (sign) test',
      report:['Sample mean and standard deviation','The benchmark value tested against','Mean difference, 95% confidence interval, and p value','Effect size (Cohen d)'],
      tags:['Compares your mean to a target'],note:'Use only when comparing your group mean to a single fixed standard.'
    };
  }

  // categorical
  if(o==='cat'){
    if(c==='prepost') return {
      name:'McNemar test',sub:'Paired yes or no outcome',
      primary:'McNemar test',alt:'For very small numbers, an exact version of the McNemar test',
      report:['A 2 by 2 table of before versus after status','Counts and percentages in each cell','The McNemar statistic and p value'],
      tags:['Same patients counted twice'],
      note:'Use this when the same individuals are classified yes or no before and after. If instead you tracked an aggregate monthly percentage, a run or control chart fits better.'
    };
    if(c==='twogroup') return {
      name:'Chi-square test of independence',sub:'Yes or no outcome, two separate groups',
      primary:'Chi-square test of independence',alt:'If any expected cell count is under 5: Fisher exact test',
      report:['A contingency table of group by outcome','Counts and percentages','Chi-square (or Fisher) statistic and p value','Effect size (phi or Cramer V)'],
      tags:['Two independent groups'],note:'Check expected counts. Small cells push you to the Fisher exact test.'
    };
    if(c==='multi') return {
      name:'Chi-square test',sub:'Yes or no outcome across three or more groups',
      primary:'Chi-square test of independence',alt:'If expected counts are small: Fisher exact test',
      report:['A contingency table of group by outcome','Counts and percentages','Chi-square statistic and p value','Effect size (Cramer V)'],
      tags:['Three or more groups'],note:'Same logic as the two-group case, extended across more groups.'
    };
    if(c==='benchmark') return {
      name:'One-sample proportion test',sub:'A single percentage compared to a target',
      primary:'One-sample proportion test (z) or binomial test',alt:'The exact binomial test for small samples',
      report:['Observed proportion and sample size','The benchmark proportion','Test statistic, 95% confidence interval, and p value'],
      tags:['Your rate vs a target'],note:'Use when comparing one observed percentage to a fixed standard.'
    };
  }

  // ordinal
  if(o==='ord'){
    if(c==='prepost') return ordinal('Wilcoxon signed-rank test','one group before and after');
    if(c==='twogroup') return ordinal('Mann-Whitney U test','two separate groups');
    if(c==='multi')   return ordinal('Kruskal-Wallis test (groups) or Friedman test (repeated time points)','three or more groups or time points');
    if(c==='benchmark') return {
      name:'Compare medians to the target',sub:'Ordinal outcome versus a fixed value',
      primary:'Report the median and interquartile range against the target',alt:'A one-sample sign test if a formal test is needed',
      report:['Median and interquartile range','The target value','Plain statement of where the group sits relative to the target'],
      tags:['Ordinal vs a target'],note:'Ordinal data are summarized with medians, not means.'
    };
  }

  // fallback (rate collapsed to prepost)
  if(o==='rate' && c==='prepost'){
    return {
      name:'Compare two proportions, but consider a chart instead',sub:'Rate collapsed to a single before and after',
      primary:'Chi-square or McNemar test on the proportion, depending on whether the same units are counted twice',
      alt:'Strongly consider a run chart instead, which shows whether the change held',
      report:['Before and after percentages with counts','The test statistic and p value if used','A note on why a single comparison may understate or overstate a process change'],
      tags:['A chart usually tells you more'],
      note:'Collapsing a tracked rate into one before-and-after number throws away the time pattern. A run chart is usually the better choice.'
    };
  }

  return null;
}

function wrap(primary,alt,d,otype,kind){
  const useAlt = d==='nonparam';
  const names={paired:'one group before and after',indep:'two separate groups',multi:'three or more groups or time points'};
  return {
    name: useAlt? alt : primary,
    sub:'Continuous outcome, '+names[kind]+(useAlt?', small or skewed sample':', adequate and symmetric sample'),
    primary: useAlt? alt : primary,
    alt: useAlt? ('If your sample were larger and symmetric: '+primary) : ('If the outcome is skewed or the sample is small: '+alt),
    report: useAlt
      ? ['Medians and interquartile range for each condition','The test statistic and p value','An effect size (r) where available']
      : ['Means and standard deviations for each condition','Mean difference with its 95% confidence interval','The test statistic and p value','An effect size (Cohen d, or eta-squared for ANOVA)'],
    tags: useAlt? ['Rank-based','Robust to skew and small n'] : ['Mean-based','Simple and widely understood'],
    note: useAlt
      ? 'With small or skewed data the rank-based test protects you from misleading results. Report the confidence interval and effect size, since a real change can still miss significance at small n.'
      : 'This is the simplest defensible choice for your situation. Still report the confidence interval and effect size, not the p value alone.'
  };
}
function ordinal(test,structure){
  return {
    name:test,sub:'Ordinal outcome, '+structure,
    primary:test,alt:'Ordinal data are always handled with rank-based tests, so there is no parametric alternative here',
    report:['Median and interquartile range for each condition','Frequencies across the rating levels','The test statistic and p value','An effect size (r) where available'],
    tags:['Rank-based','Correct for ordered ratings'],
    note:'Treat ordered ratings as ordinal and summarize them with medians. Avoid reporting a mean of a single Likert item as if it were continuous.'
  };
}

/* ---------- design engine ---------- */
function designFor(s){
  const o=s.otype, c=s.compare, r=s.rand;
  if(c==='describe') return {name:'Descriptive design', def:'You observe and summarize one group at one or more points, without manipulating anything or comparing against a separate group. Appropriate when the aim is to document current practice or an outcome.'};
  if(c==='timeseries' || (c==='multi' && o==='rate')) return {name:'Interrupted time series design (quasi-experimental)', def:'You measure the outcome repeatedly before and after a change and look for a shift in the pattern. Displayed as a run or control chart, this is one of the strongest non-randomized designs for showing that a change actually took hold.'};
  if(c==='prepost') return {name:'One-group pretest-posttest design (pre-experimental)', def:'You measure one group before and after the change, with no comparison group. This is the most common practice-project design. It is simple, but it cannot rule out other explanations for a change, so interpret the result modestly.'};
  if(c==='twogroup'){
    if(r==='rand') return {name:'Experimental design (randomized controlled trial)', def:'Participants are randomly assigned to intervention or comparison. Random assignment plus a comparison group is the hallmark of a true experiment, which usually shifts the work into generalizable research requiring full IRB review. If the aim is local improvement, consider a quasi-experimental design instead.', flag:true};
    return {name:'Quasi-experimental, nonequivalent comparison group design', def:'You compare an intervention group with a separate comparison group that was not randomly assigned. Stronger than a single group because it gives you something to compare against, while staying feasible in a practice setting.'};
  }
  if(c==='multi') return {name:'Multi-group or repeated-measures comparison (quasi-experimental or comparative)', def:'If your three or more points are spread over time, this is an interrupted time series. If they are separate groups measured once, it is a multi-group comparative design. Neither uses randomization, so it stays quasi-experimental or descriptive.'};
  if(c==='benchmark') return {name:'Benchmark comparison (descriptive or pre-experimental)', def:'You compare your group against a fixed external standard or organizational target rather than against a concurrent comparison group.'};
  return {name:'Descriptive design', def:'Summarize what you observed.'};
}

/* ---------- methods summary generator ---------- */
function artic(name){
  if(/^one\b/i.test(name)) return 'a';
  return /^[aeiou]/i.test(name) ? 'an' : 'a';
}
function methodPhrase(name){
  const proper=['McNemar','Mann-Whitney','Wilcoxon','Fisher','ANOVA','Friedman','Kruskal'];
  if(proper.some(p=>name.startsWith(p))) return name;
  return name.charAt(0).toLowerCase()+name.slice(1);
}
function summaryFor(s){
  const o=s.otype, c=s.compare, r=s.rand, dist=s.dist;
  const d=designFor(s);
  const rec=recommend(s);
  const otp={cont:'a continuous variable',cat:'a dichotomous categorical variable (yes or no)',ord:'an ordinal variable',rate:'a rate or proportion measured repeatedly over time'}[o];
  const P=[];

  // framing
  if(d.flag){
    P.push(`This project uses ${artic(d.name)} ${d.name.toLowerCase()} to evaluate [intervention] for [process or outcome] within [setting]. Because the design includes random assignment to groups, it will likely be classified as research and should be submitted for full institutional review board review before implementation. If the intent is local practice improvement, consider a quasi-experimental design instead.`);
  } else {
    P.push(`This [EBP or QI] project uses ${artic(d.name)} ${d.name.toLowerCase()} to improve [process or outcome] within [setting]. Because the aim is local practice improvement rather than the development of generalizable knowledge, the project is expected to meet criteria for a non-research or exempt determination, with the final determination made by the reviewing institutional review board.`);
  }

  // variable + comparison
  let comp='';
  if(c==='prepost') comp='measured in a single group before and after the intervention';
  else if(c==='twogroup') comp=(r==='rand'?'compared between a randomly assigned intervention group and a control group':'compared between an intervention group and a separate, nonrandomized comparison group');
  else if(c==='multi') comp='compared across three or more time points or groups';
  else if(c==='benchmark') comp='compared against an established benchmark or organizational target';
  else if(c==='timeseries') comp='measured repeatedly across multiple time points before and after the intervention';
  else comp='summarized for the sample without a formal comparison';
  P.push(`The primary outcome, [outcome variable], is operationalized as ${otp} and is ${comp} (anticipated N = [enter sample size]).`);

  // analysis
  let reportClause;
  if(o==='cont') reportClause='Descriptive statistics (means and standard deviations) will summarize the sample, and the effect size (Cohen d) along with the 95% confidence interval will be reported alongside the test result, so that the practical size of any change is clear.';
  else if(o==='cat') reportClause='Frequencies and percentages will summarize the sample, and an effect size (phi or Cramer V) will be reported alongside the test result.';
  else if(o==='ord') reportClause='Medians and interquartile ranges will summarize the sample, and an effect size (r) will be reported alongside the test result.';
  else reportClause='Rates or percentages will be summarized before and after, and the practical size of the change will be described.';

  let analysis='';
  if(c==='timeseries'){
    analysis='Data will be plotted on a run chart with a median centerline and interpreted using established run-chart rules (a shift of six or more consecutive points on one side of the median, a trend of five or more points, or an unusually extreme point). As additional data points accumulate (approximately 15 to 20), a control chart will be used to distinguish common cause from special cause variation.';
  } else if(c==='describe'){
    analysis=`Data will be summarized using descriptive statistics (${rec.primary.charAt(0).toLowerCase()+rec.primary.slice(1)}). No inferential test is planned, because the aim is to describe the outcome rather than to test a hypothesis.`;
  } else {
    let altClause='';
    if(o==='cont') altClause = (dist==='nonparam')
      ? ' This rank-based test is selected because the sample is small or the outcome is skewed.'
      : ' If the assumption of normality is not met, the equivalent nonparametric test will be used instead.';
    else if(o==='cat' && c!=='prepost') altClause=' If any expected cell count is below five, the Fisher exact test will be used instead.';
    analysis=`Data will be analyzed using the ${methodPhrase(rec.primary)}.${altClause} ${reportClause}`;
  }
  P.push(analysis);

  // limitation
  let lim='';
  if(c==='prepost') lim='As a single-group design without a comparison group, observed changes cannot be attributed to the intervention with certainty, and results should be interpreted accordingly.';
  else if(c==='twogroup' && r==='rand') lim='Random assignment strengthens causal interpretation. Note that a randomized design typically constitutes research and requires full institutional review board review.';
  else if(c==='twogroup') lim='Because participants are not randomly assigned, preexisting differences between the groups may influence the results and should be considered when interpreting the findings.';
  else if(c==='timeseries') lim='Time-series analysis shows whether a change occurred and was sustained, but cannot by itself establish that the intervention caused the change.';
  else if(c==='benchmark') lim='Comparison to a fixed benchmark does not account for concurrent changes in the setting and should be read as a gauge against a standard rather than as a controlled comparison.';
  if(lim) P.push(lim);

  return P.join('\n\n');
}

/* ---------- rendering ---------- */
